# ── Plex ──────────────────────────────────────────────────────────────────────
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your-plex-token-here
PLEXAPI_HEADER_IDENTIFIER=media-servarr-sync
TZ=America/New_York
PLEX_TIMEOUT=60

# ── Rclone (set USE_RCLONE=false if you don't use an rclone VFS mount) ────────
USE_RCLONE=false
RCLONE_RC_URL=http://192.168.1.100:5572
RCLONE_RC_USER=
RCLONE_RC_PASS=
RCLONE_MOUNT_ROOT=/mnt/media

# ── Timing ────────────────────────────────────────────────────────────────────
WEBHOOK_DELAY=30
MINIMUM_AGE=0
SYNC_COOLDOWN=5m

# ── History ───────────────────────────────────────────────────────────────────
HISTORY_DAYS=7

# ── Sonarr / Radarr (optional — enables quality profile & custom format lookups) ──
SONARR_URL=http://192.168.1.100:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.100:7878
RADARR_API_KEY=

# ── Path mappings ─────────────────────────────────────────────────────────────
PATH_REPLACEMENTS={ "/data/tv": "/mnt/media/tv", "/data/movies": "/mnt/media/movies" }
RCLONE_PATH_REPLACEMENTS={ "/data/tv": "/mnt/media/tv", "/data/movies": "/mnt/media/movies" }
SECTION_MAPPING={ "/mnt/media/tv": "1", "/mnt/media/movies": "2" }

# ── Notifications (optional) ──────────────────────────────────────────────────
# Notify one or more targets when a sync finishes. Separate them with commas.
# Any Apprise URL works (https://github.com/caronc/apprise/wiki), e.g.
#   discord://webhook_id/webhook_token
#   tgram://bot_token/chat_id
#   ntfy://ntfy.sh/my-topic
#   gotify://gotify.example.com/token
#   mailto://user:pass@gmail.com
# Any other http(s):// URL receives the full sync result as a JSON POST.
# NOTIFY_ON: error (failures only, default) | all (every sync) | off
NOTIFY_URLS=
# Left commented so it stays editable on the Settings page — an env var that is
# set (even to its default) locks the field there.
#NOTIFY_ON=error

# ── Manual UI ─────────────────────────────────────────────────────────────────
MANUAL_USER=admin
MANUAL_PASS=changeme
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ── Volume / port ─────────────────────────────────────────────────────────────
# MEDIA_ROOT     = host path to your media (mounted into the container)
# CONTAINER_MEDIA = path inside this container where media is mounted
#                   This must match the path Plex uses to see your files.
#                   Used as the mount target and for MINIMUM_AGE file-age checks.
MEDIA_ROOT=/mnt/media
CONTAINER_MEDIA=/mnt/media
PORT=5000
